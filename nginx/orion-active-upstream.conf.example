# Plantilla inicial. En el VPS este archivo vive en
# /etc/nginx/orion-active-upstream.conf (fuera del repo) y lo reescribe
# deploy.sh en cada despliegue — el contenido real es siempre una sola
# línea con el puerto del contenedor activo (ORION_BLUE_PORT o
# ORION_GREEN_PORT, ver .env.production.example). El valor de abajo es
# solo un ejemplo para arrancar el archivo antes del primer deploy.
server 127.0.0.1:3011;
