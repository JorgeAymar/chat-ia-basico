# ─────────────────────────────────────────────────────────────
#  orion-chat · plantilla de producción (VPS)
#  Copiala en el VPS como .env.production y completá los valores reales.
#  Este archivo NO se versiona — ni el .example con secretos reales, ni el
#  .env.production final (agregalo a .gitignore si vas a versionar la carpeta
#  de deploy en algún lado).
# ─────────────────────────────────────────────────────────────

# ── Identidad de la app ──────────────────────────────────────
APP_NAME="Orion Chat"
APP_VERSION="1.0.0"

# ── Postgres ─────────────────────────────────────────────────
# Usadas por docker-compose.prod.yml para levantar el contenedor de Postgres.
POSTGRES_USER="chatuser"
POSTGRES_PASSWORD=""
POSTGRES_DB="chat_ia_basico"

# Ojo: acá el host es "postgres" (nombre del servicio en la red interna de
# Docker), NO localhost — localhost adentro del contenedor de la app sería
# el contenedor mismo, no el de la base.
DATABASE_URL="postgresql://chatuser:CAMBIAR@postgres:5432/chat_ia_basico?schema=public"

# ── Autenticación ────────────────────────────────────────────
# URL pública real, con https.
APP_URL="https://orion.labshub.cc"

# openssl rand -base64 32
SESSION_SECRET=""

# El primer usuario. No se crea solo: corré `npx tsx scripts/bootstrap-owner.ts`
# desde el contenedor/checkout después del primer deploy (deja al owner en
# estado INVITED, con enlace para poner contraseña).
OWNER_EMAIL=""

# DEV_AUTH_BYPASS NO va acá. Su ausencia es la segunda barrera de
# /api/auth/dev/bootstrap-owner: si algún día aparece en este archivo,
# esa ruta queda expuesta sin login a cualquiera que la encuentre.

# ── Despliegue blue/green (deploy.sh) ──────────────────────────
# Dos puertos localhost distintos para alternar el contenedor activo sin
# caída. En un VPS compartido con otros sitios, elegí dos que estén libres
# (revisá con `ss -tlnp`) — no hay un default seguro para todas las
# máquinas, por eso deploy.sh exige que estén seteados acá.
ORION_BLUE_PORT=""
ORION_GREEN_PORT=""

# Subred /24 propia para la red Docker de este stack (ver el comentario en
# docker-compose.prod.yml — el pool de subredes automático de Docker se
# agota en un VPS con muchos stacks).
ORION_NETWORK_SUBNET=""

# Overrides opcionales de deploy.sh — comentados a propósito, ya tienen un
# default seguro namespaced con "orion". Solo hace falta descomentarlos si
# ya existe algo con ese nombre/ruta en este VPS compartido.
# ORION_STATE_FILE="/etc/orion/active_port"
# ORION_NGINX_UPSTREAM_FILE="/etc/nginx/orion-active-upstream.conf"
# ORION_HEALTH_PATH="/api/models"
# ORION_HEALTH_RETRIES="30"
# ORION_HEALTH_DELAY="2"

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
OLLAMA_DEFAULT_MODEL="gemma4:31b-cloud"

# ── Búsqueda web ─────────────────────────────────────────────
# openssl rand -hex 32 — es la SEARXNG_SECRET del contenedor de SearXNG,
# no tiene relación con SESSION_SECRET de arriba.
SEARXNG_SECRET=""
# Igual que DATABASE_URL: nombre del servicio interno, no localhost.
SEARXNG_BASE_URL="http://searxng:8080"

# ── SMTP (invitaciones y reset de contraseña) ───────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Orion Chat <no-reply@labshub.cc>"
