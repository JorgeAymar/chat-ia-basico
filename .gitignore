# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/orion-chat-web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/orion-chat-web/coverage

# next.js
/orion-chat-web/.next/
/orion-chat-web/out/

# production
/orion-chat-web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/orion-chat-web/src/generated/prisma

# orion-chat-mobile/ es un proyecto Next.js aparte (ver su next.config.ts)
# con su propio ciclo de build — los patrones de arriba son con slash
# inicial (anclados a la raíz) y no lo alcanzan.
/orion-chat-mobile/node_modules
/orion-chat-mobile/.next/
/orion-chat-mobile/next-env.d.ts
/orion-chat-mobile/*.tsbuildinfo
/orion-chat-mobile/.env*
!/orion-chat-mobile/.env.example

# Playwright
/orion-chat-web/test-results/
/orion-chat-web/playwright-report/
/orion-chat-web/playwright/.cache/
# Cookies de la sesión de test que genera e2e/global-setup.ts.
/orion-chat-web/e2e/.auth/
.gstack/
