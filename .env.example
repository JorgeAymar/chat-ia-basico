# ─────────────────────────────────────────────────────────────
#  orion-chat · plantilla de configuración
#  Copiala a .env y completá los valores: `cp .env.example .env`
# ─────────────────────────────────────────────────────────────

# ── Identidad de la app ──────────────────────────────────────
# Nombre y versión que muestra la UI. Van sin prefijo: la clave `env` de
# next.config.ts se encarga de exponerlas al navegador. Next las incrusta al
# compilar, así que después de cambiarlas hay que reiniciar el servidor.
APP_NAME="Orion Chat"
APP_VERSION="1.0.0"

# ── Base de datos ────────────────────────────────────────────
# Coincide con las credenciales del docker-compose.yml. El puerto 5436
# se eligió para no chocar con otros Postgres corriendo en la máquina.
DATABASE_URL="postgresql://chatuser:chatpass@localhost:5436/chat_ia_basico?schema=public"

# ── Ollama ───────────────────────────────────────────────────
# Local con `ollama serve`, o la URL de un Ollama remoto detrás de proxy.
OLLAMA_BASE_URL="http://localhost:11434"

# Token bearer, SOLO si tu Ollama está detrás de un proxy que lo pide.
# Con Ollama local dejalo vacío o borrá la línea.
OLLAMA_API_KEY=""

# Modelo preseleccionado al abrir la app, si está instalado (opcional).
# El selector se llena siempre en vivo con GET /api/tags de Ollama
# (equivalente a `ollama list`): no hay allow-list en .env.
OLLAMA_DEFAULT_MODEL="llama3"

# ── Búsqueda web ─────────────────────────────────────────────
# SearXNG del docker-compose.yml. El contenedor escucha en 8080.
# Si no lo levantás, el botón de búsqueda web avisa y el chat sigue
# funcionando sin buscar.
SEARXNG_BASE_URL="http://localhost:8080"

# ── Autenticación ────────────────────────────────────────────
# URL pública de la app, para armar enlaces absolutos en los emails.
APP_URL="http://localhost:3000"

# Clave para firmar la cookie de sesión. Generala con:
#   openssl rand -base64 32
# Cambiarla invalida todas las sesiones activas de una.
SESSION_SECRET=""

# Único usuario que arranca con acceso y puede invitar gente nueva.
# Se crea automáticamente al iniciar la app si todavía no existe.
OWNER_EMAIL="vos@tu-dominio.com"

# Habilita POST /api/auth/dev/bootstrap-owner (desarrollo local y tests
# E2E). NUNCA declarar esta variable en producción.
DEV_AUTH_BYPASS="true"

# ── Envío de invitaciones y magic links (SMTP) ──────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Orion Chat <no-reply@tu-dominio.com>"
