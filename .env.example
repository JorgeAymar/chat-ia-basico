# Postgres (levantado con docker-compose.yml)
DATABASE_URL="postgresql://chatuser:chatpass@localhost:5435/chat_ia_basico?schema=public"

# Ollama corriendo en local (ollama serve)
OLLAMA_BASE_URL="http://localhost:11434"

# El dropdown de modelos se llena SIEMPRE con lo que devuelva `GET /api/tags`
# de Ollama (equivalente a `ollama list`). No hay allow-list en .env.

# Modelo preseleccionado al abrir la app, si está instalado (opcional)
OLLAMA_DEFAULT_MODEL="llama3"
